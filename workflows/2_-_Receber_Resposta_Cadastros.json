      "position": [
        -8560,
        80
      ],
      "parameters": {
        "jsCode": "const dadosRedis = JSON.parse($json.dadosCadastros);\n\nconst webhook = $('Webhook').item.json;\n\nconst resposta =\n  webhook.body?.payload?.vote?.selectedOptions?.[0] ?? null;\n\nconst pollId =\n  webhook.body?.payload?._data?.RawMessage\n    ?.pollUpdateMessage\n    ?.pollCreationMessageKey\n    ?.ID ?? null;\n\nreturn {\n  json: {\n    itemId: dadosRedis.itemId,\n    cliente: dadosRedis.cliente,\n    etapa: dadosRedis.etapa,\n    resposta,\n    pollId\n  }\n};"
      }
    },
