      ],
      "parameters": {
        "jsCode": "// Inclusão concluída e as três réguas marcadas como Enviado (pelo WhatsApp ou direto no Lists)\nconst enviado = v => String(v ?? '').trim().toLowerCase() === 'enviado';\nreturn $input.all()\n  .filter(i => i.json.id)\n  .filter(i => { const f = i.json.fields || {}; return enviado(f.Reguade30Dias) && enviado(f.Reguade60Dias) && enviado(f.Reguade1Ano); })\n  .map(i => ({ json: { id: String(i.json.id), StatusAutomacao: 'Inclusão e Régua Concluídas' } }));"
      }
    },
