    {
      "id": "a3b15653-f31a-4e3f-ada3-263e7fe0e387",
      "name": "Localizar enquetes desta etapa",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4384,
        -656
      ],
      "parameters": {
        "jsCode": "// Decide se a etapa ainda precisa ser executada, olhando as enquetes de WhatsApp abertas\nconst acao = $('Loop nas Ações').item.json;\nconst abertas = etapa => Object.entries($json || {})\n  .filter(([k, v]) => {\n    try { const d = JSON.parse(v); return String(d.itemId) === String(acao.itemId) && d.etapa === etapa; }\n    catch (e) { return false; }\n  })\n  .map(([k]) => k);\n\nconst daEtapa = abertas(acao.etapa);\nconst daProxima = acao.proximaEtapa ? abertas(acao.proximaEtapa) : [];\n\n// Executa só se a enquete desta etapa está aberta e a da próxima ainda não foi enviada.\n// Caso contrário a etapa já foi respondida pelo WhatsApp e não pode ser repetida.\nif (daEtapa.length === 0 || daProxima.length > 0) return [{ json: { pular: true } }];\n\n// Fecha as enquetes abertas desta etapa (original + lembretes) para um clique atrasado não repetir a etapa\nreturn daEtapa.map(chave => ({ json: { chave, pular: false } }));\n"
      }
    },
