    {
      "id": "2d9f27f3-efbd-4f7d-b9b2-60827f67b325",
      "name": "Listar Ações",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3488,
        -32
      ],
      "parameters": {
        "jsCode": "// Uma ação por item, na ordem em que devem acontecer\n// ID único por execução: a trava de clique duplo dos fluxos de resposta usa esse ID,\n// então repetir o mesmo ID (ex.: testar o mesmo item de novo) fazia a etapa ser ignorada\nconst execucao = Date.now();\nconst acoes = [];\nfor (const item of $('Detectar Alterações Manuais').all()) {\n  for (const a of item.json.acoes || []) acoes.push({ ...a, pollId: `lists-${a.itemId}-${a.area}-${a.passo}-${execucao}` });\n}\n// Só espera o fluxo processar quando a próxima ação depende desta (mesma área do mesmo item)\nreturn acoes.map((a, i) => {\n  const prox = acoes[i + 1];\n  return { json: { ...a, aguardar: !!prox && prox.itemId === a.itemId && prox.area === a.area } };\n});"
      }
    },
