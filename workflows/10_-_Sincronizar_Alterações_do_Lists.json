    {
      "id": "aa9615f4-e129-410a-838b-aac3a7bc9a56",
      "name": "Detectar Alterações Manuais",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3040,
        -432
      ],
      "parameters": {
        "jsCode": "// Compara o status atual de cada área no Lists com o último status conhecido (Redis)\n// e gera as ações para as etapas que avançaram.\n// Quem decide se a etapa ainda precisa ser executada é a checagem de enquete aberta (mais adiante),\n// então alterações feitas pela própria automação não disparam nada de novo.\nconst AREAS = {\n  fin: { campo: 'FinanceiroStatus', fase: 'Aguardando Financeiro e Cadastros',\n         niveis: { 'Aguardando Cadastro': 0, 'Cadastro Realizado': 1, 'Concluido': 1 } },   // Financeiro: só a etapa de cadastro (19/11/2026)\n  cad: { campo: 'CadastrosStatus', fase: 'Aguardando Financeiro e Cadastros',\n         niveis: { 'Aguardando Cadastros': 0, 'Concluido': 1 } },\n  com: { campo: 'ComercialStatus', fase: 'Aguardando Comercial e Operacional',\n         niveis: { 'Aguardando Comercial': 0, 'Kit de Boas-Vindas Enviado': 1, 'Aguardando Inclusao no Grupo': 1, 'Concluido': 2 } },\n  ope: { campo: 'OperacionalStatus', fase: 'Aguardando Comercial e Operacional',\n         niveis: { 'Aguardando Operacional': 0, 'Contato com Cliente Realizado': 1, 'Placa Instalada': 2, 'Concluido': 3 } }\n};\n\n// Nome padrão de cada nível (usado para desfazer alteração feita antes da hora)\nconst NOMES = {\n  com: ['Aguardando Comercial', 'Aguardando Inclusao no Grupo', 'Concluido'],\n  ope: ['Aguardando Operacional', 'Contato com Cliente Realizado', 'Placa Instalada', 'Concluido']\n};\n\n// O que cada etapa faria se tivesse sido confirmada pela enquete / pelo e-mail\nconst enquete = (path, prefixo, voto, etapa) => ({ tipo: 'enquete', path, prefixo, voto, etapa });\nconst PASSOS = {\n  fin: [null,\n    { tipo: 'financeiro', sufixo: 'cadastro' }],\n  cad: [null,\n    enquete('inclusao-cadastros', 'inclusao:cadastros:poll:', '✅ Cadastros concluídos', 'Cadastros')],\n  com: [null,\n    enquete('inclusao-comercial', 'inclusao:comercial:poll:', '✅ Kit de Boas-Vindas enviado', 'Kit Boas-Vindas Comercial'),\n    enquete('inclusao-comercial', 'inclusao:comercial:poll:', '✅ Inclusão no grupo realizada', 'Inclusao Grupo Comercial')],\n  ope: [null,\n    enquete('inclusao-operacional', 'inclusao:operacional:poll:', '✅ Contato realizado', 'Contato Cliente Operacional'),\n    enquete('inclusao-operacional', 'inclusao:operacional:poll:', '✅ Placa instalada', 'Instalacao Placa Operacional'),\n    enquete('inclusao-operacional', 'inclusao:operacional:poll:', '✅ Equipe orientada', 'Orientacao Equipe Operacional')]\n};\n\nconst saida = [];\n\n// O nó do Redis devolve só o \"snapshot\"; os dados do Lists vêm do nó de busca (mesma ordem)\nconst itensLists = $('Buscar Inclusões em Andamento').all();\nconst snapshots = $input.all();\n\nfor (let i = 0; i < itensLists.length; i++) {\n  const j = itensLists[i].json;\n  const f = j.fields || {};\n  const itemId = String(j.id ?? f.id ?? '');\n  if (!itemId) continue;\n\n  let snap = null;\n  const bruto = snapshots[i]?.json?.snapshot;\n  try { snap = bruto ? JSON.parse(bruto) : null; } catch (e) { snap = null; }\n\n  const novoSnap = { ...(snap || {}) };\n  const acoes = [];\n  const reverter = [];\n\n  for (const [a, cfg] of Object.entries(AREAS)) {\n    const agora = cfg.niveis[f[cfg.campo]];\n    if (agora === undefined) continue;             // status fora do padrão: ignora\n    // Item ainda não visto: todo item nasce com as 4 áreas em \"Aguardando\" (nível 0).\n    // Se já foi respondido pelo WhatsApp/e-mail, as checagens seguintes impedem a repetição.\n    const primeiraVez = snap?.[a] === undefined;\n    const antes = primeiraVez ? 0 : snap[a];\n\n    const acao = passo => {\n      const p = PASSOS[a][passo];\n      const prox = PASSOS[a][passo + 1];\n      if (p) acoes.push({ ...p, area: a, passo, primeiraVez, proximaEtapa: prox?.etapa || null, itemId, cliente: f.Title || 'Cliente' });\n    };\n\n    if (agora > antes && f.StatusAutomacao !== cfg.fase) {\n      // Comercial/Operacional alterado antes de ser liberado: desfaz e avisa\n      if (NOMES[a] && f.StatusAutomacao === 'Aguardando Financeiro e Cadastros') {\n        reverter.push({ area: a, campo: cfg.campo, valor: NOMES[a][antes], tentativa: f[cfg.campo] });\n        continue;                                     // mantém o status anterior registrado\n      }\n      novoSnap[a] = agora;\n      continue;\n    }\n\n    if (a === 'fin') {\n      // Financeiro: o próprio fluxo de e-mail não volta o status, então as etapas seguem em sequência nesta execução\n      if (agora > antes) for (let passo = antes + 1; passo <= agora; passo++) acao(passo);\n    } else {\n      // WhatsApp: cada etapa executada grava o próprio status no Lists (o status \"volta\" para a etapa feita).\n      // Guardamos o status que a pessoa escolheu (alvo) e executamos UMA etapa por vez,\n      // sempre a seguinte à que já está no Lists, até chegar no alvo. Se algo atrasar, a próxima verificação continua.\n      const chaveAlvo = a + '_alvo';\n      const alvoAnt = Number(snap?.[chaveAlvo] || 0);\n      let alvo = alvoAnt, progresso = null;\n      if (agora > antes && agora > alvoAnt) { progresso = antes; alvo = agora; }   // novo status escolhido\n      else if (alvoAnt > agora) { progresso = agora; }                             // ainda a caminho do alvo\n      if (progresso !== null && alvo > progresso) acao(progresso + 1);\n      if (alvo > 0) novoSnap[chaveAlvo] = alvo; else delete novoSnap[chaveAlvo];\n    }\n    novoSnap[a] = agora;\n  }\n\n  saida.push({\n    json: {\n      itemId,\n      cliente: f.Title || 'Cliente',\n      snapKey: 'inclusao:sync:snap:' + itemId,\n      novoSnap: JSON.stringify(novoSnap),\n      acoes,\n      reverter\n    }\n  });\n}\n\nreturn saida;\n"
      }
    },
