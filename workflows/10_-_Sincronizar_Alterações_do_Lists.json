      "parameters": {
        "jsCode": "// Uma atualização por campo alterado antes da área ser liberada\nconst AREA = { fin: 'Financeiro', cad: 'Cadastros', com: 'Comercial', ope: 'Operacional' };\nconst saida = [];\nfor (const item of $('Detectar Alterações Manuais').all()) {\n  for (const r of item.json.reverter || []) {\n    saida.push({ json: { id: item.json.itemId, [r.campo]: r.valor,\n      _aviso: { cliente: item.json.cliente, area: AREA[r.area], tentativa: r.tentativa, valor: r.valor } } });\n  }\n}\nreturn saida;\n"
